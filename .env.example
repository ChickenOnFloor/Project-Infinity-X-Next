# --- MongoDB ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/infinity_x?retryWrites=true&w=majority

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=keys@yourdomain.com
# Public site URL used by the Copy key button in delivery emails.
APP_URL=https://your-project.vercel.app

# --- Product -> plan mapping ---
# Just the permalink slug from each Gumroad product URL (the part after /l/)
GUMROAD_PRODUCT_WEEKLY=ffwptz
GUMROAD_PRODUCT_MONTHLY=ylkirn
GUMROAD_PRODUCT_LIFETIME=pziswz

# Optional: your own email for low/out-of-stock alerts
ADMIN_ALERT_EMAIL=you@yourdomain.com

# A long random secret only you know — generate with: openssl rand -hex 32
# Protects /admin and the admin API routes.
ADMIN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Note: there is no ALLOWED_ORIGIN here anymore. Since the storefront, the
# admin panel, and the API routes are all part of this same Next.js app,
# everything is same-origin — no CORS configuration needed at all.
